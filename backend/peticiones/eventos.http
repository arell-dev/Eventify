@base = http://localhost:3000/api
@origen = http://localhost:4200

### Consultar el catálogo público
GET {{base}}/publico/eventos

### Consultar un evento público
GET {{base}}/publico/eventos/1

### Iniciar sesión administrativa
# @name inicioAdmin
POST {{base}}/sesion
Origin: {{origen}}
Content-Type: application/json

{
  "usuario": "C25170@utp.edu.pe",
  "contrasena": "@Linux22"
}

### Listar eventos administrativos
GET {{base}}/eventos
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}

### Crear un evento con un ponente existente
# @name crearEvento
POST {{base}}/eventos
Origin: {{origen}}
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "titulo": "Taller de eventos",
  "descripcion": "Actividad académica de ejemplo.",
  "tipo": "TALLER",
  "modalidad": "VIRTUAL",
  "lugar": "",
  "enlace": "https://example.com/evento",
  "inicio": "2035-01-10T15:00:00.000Z",
  "fin": "2035-01-10T17:00:00.000Z",
  "cupo": 30,
  "ponenteId": 1
}

### Consultar el evento creado
GET {{base}}/eventos/{{crearEvento.response.body.$.id}}
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}

### Consultar sus inscripciones
GET {{base}}/eventos/{{crearEvento.response.body.$.id}}/inscripciones
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}

### Actualizar el evento creado
PUT {{base}}/eventos/{{crearEvento.response.body.$.id}}
Origin: {{origen}}
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "titulo": "Taller de eventos actualizado",
  "descripcion": "Actividad académica de ejemplo.",
  "tipo": "TALLER",
  "modalidad": "VIRTUAL",
  "lugar": "",
  "enlace": "https://example.com/evento",
  "inicio": "2035-01-10T15:00:00.000Z",
  "fin": "2035-01-10T17:00:00.000Z",
  "cupo": 30,
  "ponenteId": 1
}

### Eliminar el evento si no tiene inscripciones
DELETE {{base}}/eventos/{{crearEvento.response.body.$.id}}
Origin: {{origen}}
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}

### Consultar un evento inexistente: respuesta esperada 404
GET {{base}}/eventos/999999
Cookie: {{inicioAdmin.response.headers.Set-Cookie}}
